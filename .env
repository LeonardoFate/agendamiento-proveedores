# ============================================
# CONFIGURACIÓN SQL SERVER
# ============================================
SPRING_DATASOURCE_URL=jdbc:sqlserver://localhost:1433;databaseName=agendamiento_proveedores;trustServerCertificate=true;encrypt=false
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=TuPasswordSegura123

# ============================================
# CONFIGURACIÓN JPA/HIBERNATE
# ============================================
# validate = solo validar el esquema, no modificar la BD
# update = intentar actualizar la BD automáticamente (puede causar warnings)
# none = no hacer nada con el esquema
SPRING_JPA_HIBERNATE_DDL_AUTO=none
SPRING_JPA_SHOW_SQL=true
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.SQLServerDialect

# ============================================
# JWT
# ============================================
APP_JWT_SECRET=miClaveSecretaSuperSeguraParaPruebasDeDesarrollo12345
APP_JWT_EXPIRATION_MS=86400000

# ============================================
# EMAIL
# ============================================
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=tu_correo@gmail.com
SPRING_MAIL_PASSWORD=tu_password_app

# ============================================
# ARCHIVOS
# ============================================
FILE_UPLOAD_DIR=./uploads

# ============================================
# ZONA HORARIA
# ============================================
SPRING_JACKSON_TIME_ZONE=America/Guayaquil